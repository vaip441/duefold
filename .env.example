# Duefold production configuration template.
#
# Copy to `.env` and fill in each setting before starting with:
#   docker compose up -d
#
# Keep production secrets in your deployment's secret store, never in a committed file.

# --- Database Passwords ---
# The reference deployment creates four isolated database roles on first startup.
# Set independent, strong random passwords for each:
POSTGRES_PASSWORD=replace-with-superuser-password
DUEFOLD_DB_MIGRATION_PASSWORD=replace-with-migration-role-password
DUEFOLD_DB_RUNTIME_PASSWORD=replace-with-runtime-role-password
DUEFOLD_DB_AUTHENTICATOR_PASSWORD=replace-with-authenticator-role-password
DUEFOLD_DB_WORKER_PASSWORD=replace-with-worker-role-password

# --- Public URL and Organization ---
DUEFOLD_PUBLIC_URL=https://dataroom.example.com
DUEFOLD_ORGANIZATION_NAME=Acme Corp
DUEFOLD_OWNER_EMAIL_ALLOWLIST=founder@example.com

# --- Identity Provider (OIDC) ---
# Generic OpenID Connect provider for team member sign-in.
# Redirect URI: <DUEFOLD_PUBLIC_URL>/api/auth/oidc/callback
DUEFOLD_OIDC_ISSUER=https://identity.example.com
DUEFOLD_OIDC_CLIENT_ID=duefold-client-id
DUEFOLD_OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
# Auto prefers client_secret_post when advertised, uses client_secret_basic when
# it is the only advertised method (or discovery omits the field), and otherwise
# fails startup. Set explicitly only when the client registration requires it.
# DUEFOLD_OIDC_CLIENT_AUTH_METHOD=client_secret_basic

# --- Email Delivery ---
# Set exactly one of DUEFOLD_SMTP_URL or DUEFOLD_RESEND_API_KEY.
DUEFOLD_AUTH_MAIL_FROM=Duefold <no-reply@example.com>
DUEFOLD_SMTP_URL=smtp://user:password@smtp.example.com:587
# DUEFOLD_RESEND_API_KEY=re_...

# --- Object Storage (S3-compatible, e.g. AWS S3 or Cloudflare R2) ---
# Separate web (write-only) and worker (read/quarantine) credentials.
DUEFOLD_STORAGE_ENDPOINT=https://storage.example.com
DUEFOLD_STORAGE_REGION=auto
DUEFOLD_STORAGE_BUCKET=duefold-data
DUEFOLD_STORAGE_PATH_STYLE=false
DUEFOLD_STORAGE_CHECKSUM_SUPPORT=true
DUEFOLD_STORAGE_WEB_ACCESS_KEY_ID=replace-with-web-access-key
DUEFOLD_STORAGE_WEB_SECRET_ACCESS_KEY=replace-with-web-secret-key
DUEFOLD_STORAGE_WORKER_ACCESS_KEY_ID=replace-with-worker-access-key
DUEFOLD_STORAGE_WORKER_SECRET_ACCESS_KEY=replace-with-worker-secret-key

# --- Cryptographic Keys ---
# Generate each key independently with:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
DUEFOLD_OTP_DIGEST_KEY=replace-with-independent-256-bit-base64url-key
DUEFOLD_NETWORK_HMAC_KEY=replace-with-independent-256-bit-base64url-key
DUEFOLD_PII_HMAC_KEY=replace-with-third-independent-256-bit-base64url-key

# --- Optional Network & Session Tuning ---
# Keep the published origin bound to loopback. The reverse proxy connects through
# Docker's private network; configure its actual IP/CIDR, never `true` or a hop count.
DUEFOLD_BIND=127.0.0.1
# DUEFOLD_TRUSTED_PROXIES=172.16.0.0/12

# DUEFOLD_SESSION_IDLE_MINUTES=30
# DUEFOLD_SESSION_ABSOLUTE_HOURS=12
