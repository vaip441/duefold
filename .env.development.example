# Duefold local development and test environment template.
#
# Copy to `.env` for local development and test execution.

# --- Local database credentials ---
DUEFOLD_DATABASE_URL=postgresql://duefold_runtime:duefold_local_runtime@127.0.0.1:5432/duefold_dev
DUEFOLD_AUTH_DATABASE_URL=postgresql://duefold_authenticator:duefold_local_authenticator@127.0.0.1:5432/duefold_dev
DUEFOLD_WORKER_DATABASE_URL=postgresql://duefold_worker:duefold_local_worker@127.0.0.1:5432/duefold_dev
DUEFOLD_MIGRATION_DATABASE_URL=postgresql://duefold_migration:duefold_local_migration@127.0.0.1:5432/duefold_dev

DUEFOLD_PUBLIC_URL=http://localhost:8080
DUEFOLD_OIDC_ISSUER=https://identity.example.com
DUEFOLD_OIDC_CLIENT_ID=duefold-local
DUEFOLD_OIDC_CLIENT_SECRET=replace-with-provider-secret
DUEFOLD_OWNER_EMAIL_ALLOWLIST=owner@example.com
DUEFOLD_ORGANIZATION_NAME=Duefold Local
DUEFOLD_OTP_DIGEST_KEY=replace-with-independent-256-bit-base64url-key
DUEFOLD_NETWORK_HMAC_KEY=replace-with-independent-256-bit-base64url-key
DUEFOLD_PII_HMAC_KEY=replace-with-third-independent-256-bit-base64url-key
DUEFOLD_SMTP_URL=smtp://localhost:1025
DUEFOLD_AUTH_MAIL_FROM=Duefold <no-reply@example.com>
DUEFOLD_STORAGE_ENDPOINT=http://localhost:9000
DUEFOLD_STORAGE_REGION=us-east-1
DUEFOLD_STORAGE_BUCKET=duefold
DUEFOLD_STORAGE_PATH_STYLE=true
DUEFOLD_STORAGE_CHECKSUM_SUPPORT=true
DUEFOLD_STORAGE_WEB_ACCESS_KEY_ID=replace-with-web-access-key
DUEFOLD_STORAGE_WEB_SECRET_ACCESS_KEY=replace-with-web-secret
DUEFOLD_STORAGE_WORKER_ACCESS_KEY_ID=replace-with-worker-access-key
DUEFOLD_STORAGE_WORKER_SECRET_ACCESS_KEY=replace-with-worker-secret
DUEFOLD_ALLOW_DB_RESET=false
DUEFOLD_SESSION_IDLE_MINUTES=30
DUEFOLD_SESSION_ABSOLUTE_HOURS=12

# --- Test database (integration and authz suites) ---
DUEFOLD_TEST_DATABASE_URL=postgresql://duefold_runtime:duefold_local_runtime@127.0.0.1:5432/duefold_test
DUEFOLD_TEST_AUTH_DATABASE_URL=postgresql://duefold_authenticator:duefold_local_authenticator@127.0.0.1:5432/duefold_test
DUEFOLD_TEST_WORKER_DATABASE_URL=postgresql://duefold_worker:duefold_local_worker@127.0.0.1:5432/duefold_test
DUEFOLD_TEST_MIGRATION_DATABASE_URL=postgresql://duefold_migration:duefold_local_migration@127.0.0.1:5432/duefold_test
