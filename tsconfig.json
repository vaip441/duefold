{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "modules/*/src/**/*.ts",
    "apps/web/src/**/*.ts",
    "apps/worker/src/**/*.ts",
    "apps/cli/src/**/*.ts",
    "deploy/**/*.ts",
    "test/**/*.ts",
    "test/fixtures/**/*.mjs",
    "vitest.config.ts",
    "eslint.config.mjs"
  ],
  "exclude": ["**/dist/**", "**/node_modules/**", "test/browser/**"]
}
