# Immutable Debian package sources used by all Duefold runtime images.
#
# Snapshot IDs were retrieved from snapshot.debian.org's timestamp API on
# 2026-10-22. Check-Valid-Until is disabled because archived Release metadata
# expires by design; signatures are still verified by APT against Debian's
# archive keyring inherited from the digest-pinned Node base image.
Types: deb
URIs: https://snapshot.debian.org/archive/debian/20261022T082531Z/
Suites: trixie trixie-updates
Components: main
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
Check-Valid-Until: no

Types: deb
URIs: https://snapshot.debian.org/archive/debian-security/20261022T082445Z/
Suites: trixie-security
Components: main
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
Check-Valid-Until: no
